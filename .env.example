# Postgres connection string: postgres://user:password@host:port/db
DATABASE_URL=

# Admin panel auth (/admin)
# Generate with: node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
# IMPORTANT: escape every "$" as "\$" below — Next.js expands unescaped "$NAME" in .env
# files, which silently corrupts bcrypt hashes (they start with $2b$ / $2a$).
ADMIN_PASSWORD_HASH=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# Email sending (Resend) — used by /api/admission-form and /api/contact-form
RESEND_API_KEY=
RESEND_FROM_EMAIL=
